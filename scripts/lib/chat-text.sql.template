create or replace function command_boundary.chat_grapheme_length(points integer[]) returns integer
language plpgsql immutable strict set search_path = '' as $length$
declare
  cp integer;
  property integer;
  current_class integer;
  previous_class integer := 0;
  indic integer;
  pictograph boolean;
