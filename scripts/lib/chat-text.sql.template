create or replace function command_boundary.chat_visual_length(body text) returns integer
language sql immutable strict set search_path = '' as $adapter$
  select command_boundary.chat_grapheme_length(coalesce(array_agg(ascii(ch) order by ord), '{}'::integer[]))
  from regexp_split_to_table(command_boundary.normalize_chat_body(body), '') with ordinality p(ch, ord)
  where ch <> '';
$adapter$;

create or replace function command_boundary.validate_chat_body(body text, image_count integer) returns text
language plpgsql immutable set search_path = '' as $validate$
declare
  normalized text;
begin
  if body is null then
    raise exception using errcode = '22023', message = 'Body must be a string.';
  end if;
  if image_count is null or image_count < 0 or image_count > 4 then
    raise exception using errcode = '22023', message = 'Image count must be an integer between 0 and 4.';
  end if;
  normalized := command_boundary.normalize_chat_body(body);
  if command_boundary.chat_visual_length(normalized) > 10000 then
    raise exception using errcode = '22023', message = 'Body must be 10000 visual characters or fewer.';
  end if;
  if image_count = 0 and not exists (
    select 1 from regexp_split_to_table(normalized, '') ch
    where ch <> '' and (command_boundary.chat_unicode_property(ascii(ch)) & 128) = 0
  ) then
    raise exception using errcode = '22023', message = 'Body must not be blank without an image.';
  end if;
  return normalized;
end;
