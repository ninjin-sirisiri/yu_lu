begin
  foreach cp in array points loop
    property := command_boundary.chat_unicode_property(cp);
    current_class := property & 15;
    indic := (property >> 4) & 3;
    pictograph := (property & 64) <> 0;
    attach := false;
    if result > 0 then
      if previous_class = 1 and current_class = 2 then attach := true; -- GB3
      elsif previous_class between 1 and 3 or current_class between 1 and 3 then attach := false; -- GB4/5
      elsif previous_class = 9 and current_class in (9,10,12,13) then attach := true; -- GB6
      elsif previous_class in (12,10) and current_class in (10,11) then attach := true; -- GB7
      elsif previous_class in (13,11) and current_class = 11 then attach := true; -- GB8
      elsif current_class in (4,5,8) then attach := true; -- GB9/9a
      elsif previous_class = 7 then attach := true; -- GB9b
      elsif indic = 1 and conjunct = 2 then attach := true; -- GB9c
      elsif pictograph and pictograph_zwj then attach := true; -- GB11
      elsif previous_class = 6 and current_class = 6 and regional_indicators % 2 = 1 then attach := true; -- GB12/13
