    pictograph_zwj := current_class = 5 and pictograph_extend;
    pictograph_extend := pictograph or (current_class = 4 and pictograph_extend);
    if current_class = 6 then regional_indicators := regional_indicators + 1;
    else regional_indicators := 0;
    end if;
    previous_class := current_class;
  end loop;
