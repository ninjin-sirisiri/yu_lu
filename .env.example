# Root environment variables for the local Supabase CLI (git-ignored .env).
# Copy this file to `.env` and replace the placeholders with your own values.
# Never commit real secrets.

# Google OAuth (Supabase Auth > Providers > Google).
# The client ID is configured in supabase/config.toml; the secret is read here.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=put-google-client-secret-here

# Where Google sends the user back to Supabase.
# Simulator/local: http://127.0.0.1:54321/auth/v1/callback
# Physical iPhone: use the HTTPS tunnel described in docs/operations/iphone-local-oauth.md.
SUPABASE_AUTH_EXTERNAL_GOOGLE_REDIRECT_URI=http://127.0.0.1:54321/auth/v1/callback
