EXPO_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=put-anon-key-here
# Invite web origin (HTTPS, no path) used to build /invitation/<token>
# links and their QR codes. Missing/invalid values fail clearly — the app
# never invents a domain.
EXPO_PUBLIC_INVITE_ORIGIN=https://invite.example.com
